module(name = "bazel_java_vscode")

# TODO https://github.com/bazel-contrib/rules_bazel_integration_test for bazel testing
# Will also help automate --deleted_packages management.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "aspect_rules_ts", version = "3.9.2")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")
bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

JUNIT_JUPITER_VERSION = "5.12.1"
JUNIT_PLATFORM_VERSION = "1.12.1"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
# REPIN=1 bazel run @maven//:pin
maven.install(
    artifacts = [
        # New LSP
        "org.eclipse.lsp4j:org.eclipse.lsp4j:0.24.0",

        "com.google.guava:guava:33.4.5-jre",
        "com.google.code.gson:gson:2.12.1",
        "jakarta.annotation:jakarta.annotation-api:3.0.0",

        "org.junit.platform:junit-platform-suite-api:%s" % JUNIT_PLATFORM_VERSION,
        "org.junit.platform:junit-platform-launcher:%s" % JUNIT_PLATFORM_VERSION,
        "org.junit.platform:junit-platform-reporting:%s" % JUNIT_PLATFORM_VERSION,
        "org.junit.jupiter:junit-jupiter-api:%s" % JUNIT_JUPITER_VERSION,
        "org.junit.jupiter:junit-jupiter-params:%s" % JUNIT_JUPITER_VERSION,
        "org.junit.jupiter:junit-jupiter-engine:%s" % JUNIT_JUPITER_VERSION,

        # Test dependencies
        # TODO Update to JUnit 5
        "junit:junit:4.13.2",
        "org.hamcrest:hamcrest:2.2",
        # Benchmarking
        "org.openjdk.jmh:jmh-core:1.37",
        "org.openjdk.jmh:jmh-generator-annprocess:1.37",
        # Extra checks
        "com.uber.nullaway:nullaway:0.12.4"
    ],
    lock_file = "//:maven_install.json",
    version_conflict_policy = "pinned",
    fail_if_repin_required = True,
)
use_repo(maven, "maven")

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    java_toolchains,
    "remote_java_tools",
    "remote_java_tools_darwin_arm64",
    "remote_java_tools_darwin_x86_64",
    "remote_java_tools_linux",
    "remote_java_tools_windows",
    # JDK 21 (LTS) — default runtime; matches the JRE shipped with the extension.
    "remotejdk21_linux_toolchain_config_repo",
    "remotejdk21_macos_toolchain_config_repo",
    "remotejdk21_macos_aarch64_toolchain_config_repo",
    "remotejdk21_win_toolchain_config_repo",
    # JDK 25 (LTS) — validated as an alternate runtime for code_analysis tests.
    "remotejdk25_linux_toolchain_config_repo",
    "remotejdk25_macos_toolchain_config_repo",
    "remotejdk25_macos_aarch64_toolchain_config_repo",
    "remotejdk25_win_toolchain_config_repo",
)
register_toolchains(
    "@remotejdk21_linux_toolchain_config_repo//:all",
    "@remotejdk21_macos_toolchain_config_repo//:all",
    "@remotejdk21_macos_aarch64_toolchain_config_repo//:all",
    "@remotejdk21_win_toolchain_config_repo//:all",
    "@remotejdk25_linux_toolchain_config_repo//:all",
    "@remotejdk25_macos_toolchain_config_repo//:all",
    "@remotejdk25_macos_aarch64_toolchain_config_repo//:all",
    "@remotejdk25_win_toolchain_config_repo//:all",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_repositories = {
        "26.5.1-darwin_arm64": ("node-v26.5.1-darwin-arm64.tar.xz", "node-v26.5.1-darwin-arm64", "f4665a1e764653ec6fe7686309e8907e9ebb9ba68c4b88b9185fdc29f221559b"),
        "26.5.1-darwin_amd64": ("node-v26.5.1-darwin-x64.tar.xz", "node-v26.5.1-darwin-x64", "4436be8db0e2bd5ca3dee8c48aa8a157c9a8fef99580036ff1da8ef6aba44708"),
        "26.5.1-linux_arm64": ("node-v26.5.1-linux-arm64.tar.xz", "node-v26.5.1-linux-arm64", "0b6b0cc2a1eecbe736f9918de8b5a6c9a48d286b88bec1298a3c1e3376182ea8"),
        "26.5.1-linux_ppc64le": ("node-v26.5.1-linux-ppc64le.tar.xz", "node-v26.5.1-linux-ppc64le", "692d0c45896bf232e22b8b64a4a826ed0a70fec75545f208d120c109d0a86752"),
        "26.5.1-linux_s390x": ("node-v26.5.1-linux-s390x.tar.xz", "node-v26.5.1-linux-s390x", "ff4635062f82308dda7c7164337ad9bb383568dac984ff64b35b888e7d7a4ef3"),
        "26.5.1-linux_amd64": ("node-v26.5.1-linux-x64.tar.xz", "node-v26.5.1-linux-x64", "cc7b3484ade63bd203a9d304f21ec37a3b622b988d7bdecf1dc4d68fc44a91b7"),
        "26.5.1-windows_amd64": ("node-v26.5.1-win-x64.zip", "node-v26.5.1-win-x64", "c432c996b95cbf7568f13a0fbb37526de84a27e3a5c520c3be15f05a9a168212"),
    },
    node_version = "26.5.1",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")

npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
    npmrc = "//:.npmrc",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version_from = "@npm//:typescript/resolved.json",
)
use_repo(rules_ts_ext, "npm_typescript")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:windows_arm64",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    versions = ["1.97.1"],
    edition = "2024",
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "maven_cli",
    sha256 = "80ffca22aed9e8b9713a232f3394fd81d7f20322df75efdb2b047dbd3e3a23bb",
    urls = ["https://dlcdn.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz"],
    strip_prefix = "apache-maven-3.9.16",
    add_prefix = "src",
    build_file_content = """
alias(
    name = "bin",
    actual = "src/bin/mvn",
    visibility = ["//visibility:public"],
)
filegroup(
    name = "bin_files",
    srcs = glob(["src/**/*"], exclude = ["src/bin/mvn"]),
    visibility = ["//visibility:public"],
)
    """,
)
